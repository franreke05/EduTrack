<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas para Android 11 (API 30) e inferior.
    Excluye ficheros de sesión y preferencias locales del backup automático
    para evitar restaurar tokens de autenticación en dispositivos de terceros.
-->
<full-backup-content>
    <!-- DataStore: sesión, preferencias de usuario -->
    <exclude domain="file" path="datastore/" />
    <!-- SharedPreferences heredadas si las hubiera -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
