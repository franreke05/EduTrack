<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas para Android 12+ (API 31+).
    Excluye ficheros de sesión y preferencias locales tanto del backup en la
    nube como de la transferencia entre dispositivos, para que los datos de
    autenticación no se compartan ni restauren automáticamente.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
